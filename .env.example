# GST Settings
DEFAULT_GST_RATE=18
DEFAULT_CGST_RATE=9
DEFAULT_SGST_RATE=9
DEFAULT_IGST_RATE=0

# Receipt Settings
RECEIPT_WIDTH=80 # in mm
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS=Your Business Address
BUSINESS_CITY=Your City
BUSINESS_STATE=Your State
BUSINESS_PINCODE=123456
BUSINESS_PHONE=+919876543210
BUSINESS_EMAIL=contact@yourbusiness.com
BUSINESS_GSTIN=27XXXXXXXX1ZX

# Backup Settings
AUTO_BACKUP=true
BACKUP_FREQUENCY=daily # daily, weekly, monthly
BACKUP_PATH=./backups

# AI & Speech Recognition Configuration
VITE_GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
VITE_SPEECH_API_ENDPOINT=https://speech.googleapis.com/v1/speech:recognize
VITE_ENABLE_AI_FEATURES=true

# Business Intelligence Configuration
VITE_ENABLE_BUSINESS_INTELLIGENCE=true
VITE_AI_SALES_PREDICTION=true
VITE_AI_INVENTORY_OPTIMIZATION=true

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_MULTI_LANGUAGE=true
ENABLE_LOYALTY_PROGRAM=true
