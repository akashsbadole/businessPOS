# Application Settings
VITE_APP_NAME=businessPOS
VITE_APP_VERSION=1.0.0
VITE_API_URL=http://localhost:3000/api

# Database Configuration
# Options: 'turso', 'sqlite', 'localStorage'
DB_TYPE=turso
DB_PATH=./sqlite.db

# Turso Database Configuration (Cloud SQLite)
# Sign up at https://turso.tech and create a database
# Get URL: turso db show your-db-name --url
# Get Token: turso db tokens create your-db-name
VITE_TURSO_DATABASE_URL=libsql://your-database-name.turso.io
VITE_TURSO_AUTH_TOKEN=your_auth_token_here

# Drizzle Kit Configuration (for schema migrations)
# Use the same Turso credentials for drizzle-kit push/pull
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_auth_token_here

# Local SQLite fallback (for development without Turso)
VITE_LOCAL_DB_PATH=./local.db

# GST Settings
DEFAULT_GST_RATE=18
DEFAULT_CGST_RATE=9
DEFAULT_SGST_RATE=9
DEFAULT_IGST_RATE=0

# Receipt Settings
RECEIPT_WIDTH=80 # in mm
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS=Your Business Address
BUSINESS_CITY=Your City
BUSINESS_STATE=Your State
BUSINESS_PINCODE=123456
BUSINESS_PHONE=+919876543210
BUSINESS_EMAIL=contact@yourbusiness.com
BUSINESS_GSTIN=27XXXXXXXX1ZX

# Backup Settings
AUTO_BACKUP=true
BACKUP_FREQUENCY=daily # daily, weekly, monthly
BACKUP_PATH=./backups

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_MULTI_LANGUAGE=true
ENABLE_LOYALTY_PROGRAM=true

# Development Settings
NODE_ENV=development
VITE_DEBUG=false

# Database Connection Examples:

# 1. Use Turso Cloud Database (Recommended for production)
# DB_TYPE=turso
# VITE_TURSO_DATABASE_URL=libsql://my-pos-db.turso.io
# VITE_TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# 2. Use Local SQLite (Good for development)
# DB_TYPE=turso
# # Leave Turso credentials empty to use local SQLite
# VITE_LOCAL_DB_PATH=./pos-database.db

# 3. Use localStorage (Default fallback)
# DB_TYPE=sqlite
# # or remove DB_TYPE entirely